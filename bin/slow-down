#!/usr/bin/env node
// slow down CLI. On PATH inside Claude Code sessions while the plugin is enabled.
'use strict';

const fs = require('node:fs');
const path = require('node:path');
const { pathToFileURL } = require('node:url');

const HELP = `slow down: keep the engineer in the architect seat

Usage:
  slow-down decide <key> <reasoning...>   Record an architecture decision (the engineer's words)
  slow-down skip [--for 30m|2h] <reason>  Pause checkpoints and decision holds, with a reason
  slow-down unskip                        End an active skip
  slow-down status                        Show intensity, skip state and recent decisions
  slow-down init                          Create .slow-down/ with config, decision log and designs/

Keys look like dep:axios, schema:db/migrations/0042_orders.sql, infra:infra/lib/queue-stack.ts,
contract:api/openapi.yaml, module:src/payments, or arch:<anything> for decisions without a hook signal.`;

main().catch((err) => {
  console.error(`slow-down: ${err.message}`);
  process.exit(1);
});

async function main() {
  const lib = await import(pathToFileURL(path.join(__dirname, '..', 'scripts', 'lib.mjs')).href);
  const [cmd, ...args] = process.argv.slice(2);
  const root = lib.repoRoot(process.cwd()) || process.cwd();

  switch (cmd) {
    case 'decide':
      return decide(lib, root, args);
    case 'skip':
      return skip(lib, root, args);
    case 'unskip':
      return unskip(lib, root);
    case 'status':
      return status(lib, root);
    case 'init':
      return init(lib, root);
    default:
      console.log(HELP);
      return undefined;
  }
}

function decide(lib, root, args) {
  const [key, ...words] = args;
  const reasoning = words.join(' ').trim();
  if (!key || !/^[a-z]+:\S+$/.test(key)) throw new Error('decide needs a key like dep:axios or arch:retry-policy');
  if (!reasoning) throw new Error('decide needs the engineer\'s reasoning, in their own words');

  const dir = lib.ensureProjectDir(root);
  const file = path.join(dir, 'decisions.md');
  if (!fs.existsSync(file)) fs.writeFileSync(file, lib.DECISIONS_HEADER);
  const date = new Date().toISOString().slice(0, 10);
  fs.appendFileSync(file, `### \`${key}\` · ${date}\n\n${reasoning}\n\n`);
  console.log(`Recorded ${key} in .slow-down/decisions.md`);
}

function skip(lib, root, args) {
  let minutes = 30;
  const rest = [...args];
  const i = rest.indexOf('--for');
  if (i !== -1) {
    minutes = parseDuration(rest[i + 1]);
    rest.splice(i, 2);
  }
  const reason = rest.join(' ').trim();
  if (!reason) throw new Error('skip needs a reason, so future you knows why');

  const dir = lib.ensureProjectDir(root);
  const until = new Date(Date.now() + minutes * 60 * 1000).toISOString();
  fs.writeFileSync(path.join(dir, '.state', 'skip.json'), JSON.stringify({ until, reason }, null, 2));
  fs.appendFileSync(path.join(dir, '.state', 'skips.log'), `${new Date().toISOString()}\t${minutes}m\t${reason}\n`);
  console.log(`slow down paused for ${minutes} minutes. Reason logged locally in .slow-down/.state/skips.log`);
}

function unskip(lib, root) {
  try {
    fs.unlinkSync(path.join(lib.projectDir(root), '.state', 'skip.json'));
  } catch {
    // nothing to end
  }
  console.log('slow down is active again.');
}

function status(lib, root) {
  const cfg = lib.loadConfig(root);
  const skipping = lib.skipState(root);
  const keys = [...lib.readDecisions(root).matchAll(/^### `([^`]+)`/gm)].map((m) => m[1]);
  console.log(`Repository: ${root}`);
  console.log(`Enabled:    ${cfg.enabled}`);
  console.log(`Intensity:  ${cfg.intensity} (checkpoint every ~${cfg.checkpointLines} changed lines)`);
  console.log(`Signals:    ${cfg.signals.join(', ')}`);
  console.log(`Skip:       ${skipping ? `until ${skipping.until} (${skipping.reason})` : 'none'}`);
  console.log(`Decisions:  ${keys.length}${keys.length ? `, latest: ${keys.slice(-5).join(', ')}` : ''}`);
  const note = lib.latestDesignNote(root);
  if (note) console.log(`Design:     ${note}`);
}

function init(lib, root) {
  const dir = lib.ensureProjectDir(root);
  fs.mkdirSync(path.join(dir, 'designs'), { recursive: true });
  const config = path.join(dir, 'config.json');
  if (!fs.existsSync(config)) {
    fs.writeFileSync(
      config,
      `${JSON.stringify({ intensity: 'normal', ignore: ['**/*.generated.ts'] }, null, 2)}\n`,
    );
  }
  const decisions = path.join(dir, 'decisions.md');
  if (!fs.existsSync(decisions)) fs.writeFileSync(decisions, lib.DECISIONS_HEADER);
  const keep = path.join(dir, 'designs', '.gitkeep');
  if (!fs.existsSync(keep)) fs.writeFileSync(keep, '');
  console.log('Created .slow-down/ (config.json, decisions.md, designs/). Commit it; .state/ stays local.');
}

function parseDuration(value) {
  const m = /^(\d+)(m|h)?$/.exec(String(value || ''));
  if (!m) throw new Error('--for takes a duration like 30m or 2h');
  return Number(m[1]) * (m[2] === 'h' ? 60 : 1);
}
